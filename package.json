{
  "name": "dadofit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "DadoFit monorepo: frontend/ (web), backend/ (API), database/ (SQL), infra/ (Docker). This package only holds shared tooling and shortcuts.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "install:all": "npm ci && npm --prefix frontend ci && npm --prefix backend ci",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "test:api": "npm --prefix backend test",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "typescript": "5.9.3"
  }
}
