{
  "name": "dadofit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "prepare": "node scripts/prepare-dataset.mjs",
    "predev": "npm run prepare",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "prebuild": "npm run prepare",
    "build": "tsc -b && vite build && node scripts/copy-media.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
