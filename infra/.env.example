# DadoFit self-hosted stack - copy to infra/.env (ignored by git) and fill in.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Database ---
POSTGRES_DB=dadofit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=55432
# Login password of the least-privilege role the API uses (dadofit_api).
API_DB_PASSWORD=

# --- API ---
NODE_ENV=development
# Public URL of the web app (used in e-mail links). Production: https://<domain>
APP_PUBLIC_URL=http://localhost:8787
# At least 32 characters. Rotating it signs everyone out.
API_JWT_SECRET=
# true in production. In development the confirmation e-mail arrives in Mailpit.
AUTH_REQUIRE_EMAIL_CONFIRMATION=true
API_HOST_PORT=8782

# --- E-mail (development: Mailpit, UI on http://localhost:8785) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DadoFit <no-reply@dadofit.local>
MAILPIT_UI_HOST_PORT=8785
MAILPIT_SMTP_HOST_PORT=8786

# --- Web ---
WEB_HOST_PORT=8787
IMAGE_TAG=local

# --- File storage ---
# disk: local volume (default). s3: Amazon S3 (production target on AWS).
# Locally, s3 can be exercised with the mock:  --profile s3 up -d s3  and
#   STORAGE_DRIVER=s3 S3_ENDPOINT=http://s3:9090 S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=local S3_SECRET_ACCESS_KEY=local
STORAGE_DRIVER=disk
S3_BUCKET=dadofit-files
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_HOST_PORT=8788

# Any API variable can be supplied as a file instead: <NAME>_FILE=/run/secrets/x
# (Docker secrets, or AWS Secrets Manager / SSM values mounted as files).
# Database TLS (Amazon RDS): DATABASE_SSL=verify-full + DATABASE_SSL_CA_FILE
# pointing at the RDS CA bundle (global-bundle.pem).
