# Edge proxy for production: automatic HTTPS (Let's Encrypt) for $DOMAIN and
# forwarding to the web container (nginx), which serves the SPA and proxies /api.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8080 {
		header_up X-Forwarded-Proto https
	}
	# Access log without tokens: e-mail links (legacy ?token=, ?confirm=) and
	# signed file URLs carry them in the query string. Caddy already redacts
	# Cookie and Authorization headers.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
				replace confirm REDACTED
			}
			request>headers>Referer delete
		}
	}
}

# Redirect the www variant to the canonical domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
