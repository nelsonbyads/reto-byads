# Ephemeral Postgres with pgTAP to run the SQL test suites (mounted at /tests)
# against a database migrated from scratch. Never used for
# real data: the cluster lives in the container and disappears with it.
FROM postgres:18.4-alpine

ARG PGTAP_VERSION=1.3.3
RUN apk add --no-cache --virtual .pgtap-build make perl curl patch \
 && curl -fsSL "https://github.com/theory/pgtap/archive/refs/tags/v${PGTAP_VERSION}.tar.gz" | tar xz -C /tmp \
 && make -C "/tmp/pgtap-${PGTAP_VERSION}" \
 && make -C "/tmp/pgtap-${PGTAP_VERSION}" install \
 && rm -rf "/tmp/pgtap-${PGTAP_VERSION}" \
 && apk del .pgtap-build

COPY migrate.sh /usr/local/bin/dadofit-migrate
COPY run-sql-tests.sh /usr/local/bin/dadofit-sql-tests
ENTRYPOINT ["sh", "/usr/local/bin/dadofit-sql-tests"]
