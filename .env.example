# DadoFit — variables de la raíz del repositorio (herramientas de desarrollo)
#
# La SPA no necesita ninguna variable: habla con la API en el mismo origen
# (/api). La configuración del backend (base de datos, API, correo, archivos,
# límites) está en infra/.env, a partir de infra/.env.example.
#
# Ninguna herramienta carga este archivo sola: son variables de entorno que se
# pasan al ejecutar el comando, por ejemplo
#   API_PROXY_TARGET=http://127.0.0.1:8782 npm run dev
# o se exportan en la terminal antes de usarlo.
#
# Este archivo sustituye al antiguo .env.local (VITE_SUPABASE_URL,
# VITE_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY), que ya no usa nada
# del código actual. Solo lo necesita la web legada contra Supabase; se puede
# borrar al retirar Supabase. Nunca subirlo a git.

# --- Frontend en desarrollo (npm run dev, http://localhost:5175) ---
# Dónde reenvía Vite las peticiones /api. Por defecto, la API del stack local.
API_PROXY_TARGET=http://127.0.0.1:8782

# --- Pruebas de la API, siembra demo, integridad y carga (npm --prefix server ...) ---
# API y Mailpit del stack local.
BASE_URL=http://127.0.0.1:8782
MAILPIT_URL=http://127.0.0.1:8785
# Conexión de propietario a la base local (solo para fixtures, siembra e
# integridad). Usar la POSTGRES_PASSWORD de infra/.env.
DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55432/dadofit

# Siembra de datos demo (server/scripts/seed-demo.mjs). Valores por defecto:
SEED_ATHLETES=120
SEED_GYMS=6
SEED_BRANDS=4
# SEED_PASSWORD=   contraseña común de las cuentas demo (por defecto la de docs/ENTREGA_LOCAL.md)

# Prueba de carga (server/scripts/load-test.mjs). Valores por defecto:
LOAD_CONCURRENCY=25
LOAD_SECONDS=30
LOAD_LOGINS=40
# LOAD_USERS_FILE=infra/seed/demo-users.json

# Importación de archivos desde Supabase hacia S3 (server/scripts/import-storage-files.mjs):
# STORAGE_DRIVER, S3_* y las credenciales de origen se toman de infra/.env.import.
